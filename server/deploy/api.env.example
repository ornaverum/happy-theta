# /etc/happytheta/api.env  — settings for the Happy Theta API. Keep private:
#   sudo mkdir -p /etc/happytheta && sudo cp deploy/api.env.example /etc/happytheta/api.env
#   sudo chmod 600 /etc/happytheta/api.env && sudo nano /etc/happytheta/api.env

# Start of the links in emails: your site's address, no trailing slash.
PUBLIC_URL=https://your-domain

# Email (see README.md "Email setup"). Brevo's API works on DigitalOcean; SMTP ports are blocked there.
MAIL_TRANSPORT=brevo
BREVO_API_KEY=paste-your-brevo-api-key
MAIL_FROM=Happy Theta <noreply@your-domain>

# Optional: only allow sign-up with these email domains (comma-separated).
#ALLOWED_EMAIL_DOMAINS=asmsa.org

# Only if the site has no HTTPS yet (sign-in cookies won't work over plain http otherwise):
#COOKIE_SECURE=0

# WishIMay price comparison (optional). One SerpApi key (https://serpapi.com/manage-api-key) covers both
# Google Shopping and eBay; no eBay developer key is needed. Leave it out and the feature stays hidden.
#SERPAPI_KEY=paste-your-serpapi-key
# Searches per calendar month WishIMay may use (each price check = 2). Free plan is 250.
#SERPAPI_MONTHLY_LIMIT=240
# Country for Google Shopping, and optionally a city for local prices:
#SERPAPI_GL=us
#SERPAPI_LOCATION=Hot Springs,Arkansas,United States
