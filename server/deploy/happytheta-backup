#!/usr/bin/env bash
# Nightly copy of the Happy Theta database (safe while the server runs), kept 30 days.
# Install:  sudo apt install -y sqlite3
#           sudo cp server/deploy/happytheta-backup /usr/local/bin/ && sudo chmod +x /usr/local/bin/happytheta-backup
#           echo '17 3 * * * root /usr/local/bin/happytheta-backup' | sudo tee /etc/cron.d/happytheta-backup
# Copy /var/backups/happytheta/ off the droplet now and then (or turn on DigitalOcean backups).
set -euo pipefail
DB=${DB_PATH:-/var/lib/happytheta/happytheta.db}
DIR=/var/backups/happytheta
mkdir -p "$DIR"
STAMP=$(date +%F)
sqlite3 "$DB" ".backup '$DIR/happytheta-$STAMP.db'"
gzip -f "$DIR/happytheta-$STAMP.db"
cp /etc/happytheta/api.env "$DIR/api.env"
chmod 600 "$DIR"/*
find "$DIR" -name 'happytheta-*.db.gz' -mtime +30 -delete
